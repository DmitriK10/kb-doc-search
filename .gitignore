# Секреты и артефакты
.env
.env.*
# Но образец обязан быть в репозитории: без него непонятно, какие
# переменные нужны. Паттерн .env.* его случайно проглатывал.
!.env.example
*.key
*.pem
kb_db_pass.txt
kb_pepper.txt

# Модели (29.5 МБ int8 + 116 МБ fp32) — не в git, воспроизводятся скриптом
models/
*.onnx
*.onnx.data
.hf/

# Кэш и артефакты Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-*/

# Отчёты прогонов: генерируются заново, в git только сводка
reports/*.json
!reports/eval_*.json
!reports/smoke_db_*.json
!reports/schema_*.json
!reports/index_report.json
# Матрицы ошибок: README на них ссылается — держим в git
!reports/confusion_*.json

# Корпус генерируется скриптом — не храним бинарники DOCX
data/corpus/*.docx

# Прочее
.DS_Store
Thumbs.db
*.log

# Видео-демо: 3.3 МБ, в git не храним — лежит в облаке, ссылка в README
demo.mp4
docs/demo.mp4
