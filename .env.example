# Пример переменных окружения. Реальный .env в git не попадает.
# Пароль БД и pepper генерируются на сервере и хранятся вне репозитория.

# Строка подключения к PostgreSQL (обязательно)
KB_DSN=host=127.0.0.1 port=5432 user=kb password=CHANGE_ME dbname=kb

# Секрет для HMAC от текста запроса (обязательно, >=32 символов)
# Генерация: openssl rand -hex 32
KB_PEPPER=CHANGE_ME_32_CHARS_MINIMUM

# Каталог с ONNX-моделью (создаётся scripts/export_onnx.py)
KB_MODEL_DIR=/opt/kb/models/rubert-tiny2-int8

# Потоки onnxruntime: по числу vCPU, но не больше 2 на 2 ГБ RAM
ORT_NUM_THREADS=2
OMP_NUM_THREADS=2

# Опционально: Telegram-бот для алертов (транспорт, не логика)
# TELEGRAM_TOKEN=
# TELEGRAM_OWNER_CHAT_ID=
